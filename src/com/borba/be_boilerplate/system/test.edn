;; ─────────────────────────────────────────────────────────────────────────────
;; system/test.edn — Test profile
;;
;; Read by the integration tests, which start only the components they need
;; (the database and the event store) against the services of
;; docker-compose.yml or of the pipeline.
;; ─────────────────────────────────────────────────────────────────────────────

#deep-merge [#include "com/borba/be_boilerplate/system/base.edn"

             {:ig/system
              {:http/routes
               {:routes [["/health"        :get  :health/check]
                         ["/readyz"        :get  :health/ready]
                         ["/v1/users"      :post :user/create]
                         ["/v1/users/:id"  :get  :user/get-by-id]
                         ["/v1/orders"     :post :order/create]
                         ["/v1/orders/:id" :get  :order/get-by-id]]}

               :components/database
               {:max-pool-size 4
                :min-idle      1}

               ;; No consumer and no broker check in test
               :components/kafka-producer
               {:verify-connection? false}

               :components/kafka-consumer
               {:topics []}}}]
