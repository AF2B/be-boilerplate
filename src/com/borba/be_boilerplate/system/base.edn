{;; ────────────────────────────────────────────────────────────────────────────
 ;; system/base.edn — Base system configuration
 ;;
 ;; All Integrant keys are declared here. Profile-specific EDN files
 ;; (stag, prod, test) deep-merge on top of this base.
 ;;
 ;; Credentials and addresses come from the environment only: `.env` for local
 ;; development (see `.env.example`), the orchestrator everywhere else.
 ;;
 ;; ── Adding a new component ─────────────────────────────────────────────────
 ;; 1. Add the dep to deps.edn
 ;; 2. Add its namespace to :service/namespaces below
 ;; 3. Declare its :ig/system key here (or in a profile EDN)
 ;; 4. Hand it to the handlers through :service/components
 ;; ────────────────────────────────────────────────────────────────────────────

 ;; ── Namespaces to require before ig/init ──────────────────────────────────
 ;; borba.core.main requires each namespace so that every defmethod
 ;; (ig/init-key, registry/handler, registry/interceptor) is loaded before the
 ;; system starts. Namespaces that only other namespaces require need no entry.
 :service/namespaces
 [borba.sql-client
  borba.redis
  borba.kafka-producer
  borba.kafka-consumer
  borba.event-store
  borba.handlers.component
  borba.interceptors.component
  borba.routes.component
  borba.server.component
  com.borba.be-boilerplate.system.components
  com.borba.be-boilerplate.system.event-relay
  com.borba.be-boilerplate.system.projection
  com.borba.be-boilerplate.handlers.http.handlers
  com.borba.be-boilerplate.handlers.http.interceptors]

 ;; ── Integrant system ──────────────────────────────────────────────────────
 :ig/system
 {;; ── Lifecycle ───────────────────────────────────────────────────────────
  ;; The state readiness reports: :starting -> :ready -> :draining -> :stopped.
  :borba/lifecycle {}

  ;; Marks the service ready once the server is up. On SIGTERM it turns
  ;; readiness off and waits :drain-delay-ms, while the server still serves,
  ;; so the load balancer stops routing before the listener closes.
  :borba/core
  {:service-name   "be-boilerplate"
   :version        #or [#env APP_VERSION "dev"]
   :profile        #profile {:stag :stag :prod :prod :test :test}
   :lifecycle      #ig/ref :borba/lifecycle
   :drain-delay-ms #profile {:prod 15000 :default 0}
   :after          [#ig/ref :server/http]}

  ;; ── HTTP Server ────────────────────────────────────────────────────────
  :server/http
  {:host            "0.0.0.0"
   :port            #long #or [#env PORT 8080]
   :routes          #ig/ref :http/routes
   :stop-timeout-ms 10000}

  ;; ── HTTP Routes ────────────────────────────────────────────────────────
  ;; Routes are declared in the profile EDN: ["/path" :method :handler-key]
  ;; or, with route-level interceptors resolved from :service/interceptors,
  ;;   ["/path" :method :handler-key {:interceptors [:log-request]}]
  :http/routes
  {:routes       []
   :handlers     #ig/ref :service/handlers
   :interceptors #ig/ref :service/interceptors}

  ;; ── Interceptors ───────────────────────────────────────────────────────
  ;; Builds every interceptor registered with
  ;; borba.interceptors.registry/interceptor, closing over the components.
  :service/interceptors
  {:components #ig/ref :service/components}

  ;; ── Handlers ───────────────────────────────────────────────────────────
  ;; Builds the chain of every handler registered with
  ;; borba.handlers.registry/handler.
  :service/handlers
  {:components     #ig/ref :service/components
   :interceptors   #ig/ref :service/interceptors
   :max-body-bytes 1048576}

  ;; ── Database (PostgreSQL via next.jdbc + HikariCP) ─────────────────────
  :components/database
  {:jdbc-url      #env DATABASE_URL
   :username      #env DATABASE_USER
   :password      #env DATABASE_PASSWORD
   :max-pool-size 10
   :min-idle      2}

  ;; ── Event Store (PostgreSQL-backed append-only log) ─────────────────────
  ;; Creates its own `events` table, with the append-only triggers.
  :components/event-store
  {:database #ig/ref :components/database}

  ;; ── Redis (Carmine) ─────────────────────────────────────────────────────
  :components/redis
  {:host     #or [#env REDIS_HOST "localhost"]
   :port     #long #or [#env REDIS_PORT 6379]
   :password #env REDIS_PASSWORD}

  ;; ── Kafka Producer ──────────────────────────────────────────────────────
  ;; Every topic it writes has a JSON Schema held by the Schema Registry, and
  ;; every value is checked against it before it is sent. A topic without a
  ;; schema cannot be written to. With :register? false (prod) the start fails
  ;; when a schema is not registered; stag registers them itself.
  :components/kafka-producer
  {:bootstrap-servers #or [#env KAFKA_BROKERS "localhost:9092"]
   :client-id         "be-boilerplate-producer"
   :schema-registry
   {:url       #env SCHEMA_REGISTRY_URL
    :schemas   {"order-events"
                #include "com/borba/be_boilerplate/events/schemas/order_events.edn"}
    :register? false}}

  ;; ── Kafka Consumer ──────────────────────────────────────────────────────
  ;; With no :topics the consumer does nothing; profiles add them. Values are
  ;; read with the schema they name, from the same registry.
  :components/kafka-consumer
  {:bootstrap-servers #or [#env KAFKA_BROKERS "localhost:9092"]
   :group-id          "be-boilerplate"
   :topics            []
   :handlers          #ig/ref :kafka/consumer-handlers
   :schema-registry   {:url #env SCHEMA_REGISTRY_URL}}

  ;; ── Kafka Consumer Handlers ────────────────────────────────────────────
  ;; topic -> fully-qualified symbol of the handler, declared in the profiles:
  ;;   {"my-topic" com.borba.be-boilerplate.events.consumer/handle-my-event}
  :kafka/consumer-handlers {}

  ;; ── Components handed to every handler and interceptor ────────────────
  :service/components
  {:lifecycle      #ig/ref :borba/lifecycle
   :sql-client     #ig/ref :components/database
   :event-store    #ig/ref :components/event-store
   :redis          #ig/ref :components/redis
   :kafka-producer #ig/ref :components/kafka-producer}

  ;; ── Event relay ────────────────────────────────────────────────────────
  ;; The event store is the outbox: requests store their events and never
  ;; call Kafka; the relay publishes them, in order, at-least-once. :topics
  ;; says the topic of each aggregate type.
  :service/event-relay
  {:database       #ig/ref :components/database
   :event-store    #ig/ref :components/event-store
   :kafka-producer #ig/ref :components/kafka-producer
   :relay-name     "be-boilerplate"
   :topics         {"order" "order-events"}}

  ;; ── Projections ────────────────────────────────────────────────────────
  :projection/folding-funcs {}}}
