# Local development only. Copy to .env (never committed) and adjust.
# `make` and `docker compose` both read .env; the service reads the variables
# from the environment.

# PostgreSQL: the container is created with these, and the service uses them
POSTGRES_DB=be_boilerplate
POSTGRES_PORT=5432
DATABASE_URL=jdbc:postgresql://localhost:5432/be_boilerplate
DATABASE_USER=be_boilerplate
DATABASE_PASSWORD=change-me-locally

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka and its Schema Registry
KAFKA_PORT=9092
KAFKA_BROKERS=localhost:9092
SCHEMA_REGISTRY_PORT=8081
SCHEMA_REGISTRY_URL=http://localhost:8081

# HTTP
PORT=8080
