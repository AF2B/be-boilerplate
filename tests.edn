;; Unit tests run everywhere. Integration tests carry ^:integration metadata on
;; their namespace and run against PostgreSQL (make docker-up, or the services
;; of the pipeline).
#kaocha/v1
 {:tests    [{:id         :unit
              :test-paths ["test"]
              :skip-meta  [:integration]}
             {:id         :integration
              :test-paths ["test"]
              :focus-meta [:integration]}]

  :plugins  [:kaocha.plugin/randomize
             :kaocha.plugin/filter
             :kaocha.plugin/capture-output
             :kaocha.plugin/profiling]

  :reporter [kaocha.report/documentation]}
