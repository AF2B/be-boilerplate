 :aliases
 {;; The REPL: the service, dev/user.clj and the tests with their deps, so a
  ;; test can be run from the editor. No :main-opts.
  :dev
  {:extra-paths ["dev" "test"]
   :extra-deps
   {lambdaisland/kaocha    {:mvn/version "1.91.1392"}
    org.clojure/test.check {:mvn/version "1.1.3"}
    io.github.af2b/borba-state-flow-component
    {:git/url "https://github.com/AF2B/borba-state-flow-component"
     :git/tag "v1.0.0"
     :git/sha "a8448680a6cec250c99c8ccdc740c198ec519665"}}
   :jvm-opts    ["-Dfile.encoding=UTF-8"
                 "-Dstdout.encoding=UTF-8"
                 "-Dstderr.encoding=UTF-8"]}

  :run
  {:main-opts ["-m" "borba.core.main"]}

  :test
  {:extra-paths ["test"]
   :extra-deps
   {lambdaisland/kaocha    {:mvn/version "1.91.1392"}
    org.clojure/test.check {:mvn/version "1.1.3"}
    io.github.af2b/borba-state-flow-component
    {:git/url "https://github.com/AF2B/borba-state-flow-component"
     :git/tag "v1.0.0"
     :git/sha "a8448680a6cec250c99c8ccdc740c198ec519665"}}
   :main-opts ["-m" "kaocha.runner"]}

  :coverage
  {:extra-paths ["test"]
   :extra-deps
   {lambdaisland/kaocha           {:mvn/version "1.91.1392"}
    lambdaisland/kaocha-cloverage {:mvn/version "1.1.89"}
    org.clojure/test.check        {:mvn/version "1.1.3"}
    io.github.af2b/borba-state-flow-component
    {:git/url "https://github.com/AF2B/borba-state-flow-component"
     :git/tag "v1.0.0"
     :git/sha "a8448680a6cec250c99c8ccdc740c198ec519665"}}
   :main-opts ["-m" "kaocha.runner" "--plugin" "cloverage"
               "--cov-output" "target/coverage"
               "--focus" ":unit"]}

  :lint
  {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2026.08.04"}}
   :main-opts    ["-m" "clj-kondo.main"]}

  :fmt
  {:replace-deps {dev.weavejester/cljfmt {:mvn/version "0.16.6"}}
   :main-opts    ["-m" "cljfmt.main"]}

  :build
  {:deps       {io.github.clojure/tools.build {:mvn/version "0.10.14"}}
   :ns-default build
   :exec-args  {:lib      com.borba/be-boilerplate
                :main-ns  borba.core.main
                :uber-jar "target/app.jar"}}

  :outdated
  {:replace-deps {com.github.liquidz/antq {:mvn/version "2.11.1276"}}
   :main-opts    ["-m" "antq.core"]}}}
